# ELEMENT UX - Environment Configuration
# Optimized for immersive cinematic portfolio development

# Development Mode
NODE_ENV=development
DEBUG=true
DEBUG_LEVEL=verbose

# Three.js / WebGL Configuration
THREE_ANTIALIAS=true
THREE_PIXEL_RATIO=window.devicePixelRatio
WEBGL_CONTEXT_ATTRIBUTES={"antialias":true,"preserveDrawingBuffer":false,"precision":"highp"}

# GSAP Configuration
GSAP_AUTOPREFIX=true
GSAP_DEFAULT_EASE=power3.inOut
GSAP_SCROLL_TRIGGER_FORCE_SCROLL_ASSETS=false

# Animation Performance
ANIMATION_FPS_TARGET=60
ANIMATION_USE_RAF=true
MOTION_REDUCE_MOTION=false

# Typography & Design System
GOOGLE_FONTS_PRELOAD=true
DESIGN_TOKEN_CACHE=true
CSS_CUSTOM_PROPERTIES=true

# Performance & Optimization
ASSET_OPTIMIZATION=true
TEXTURE_COMPRESSION=ktx2
MODEL_OPTIMIZATION_LEVEL=2
LAZY_LOAD_THRESHOLD=500

# Development Server
VITE_PORT=5173
VITE_STRICT_PORT=false
VITE_HOST=0.0.0.0

# Debugging Tools
ENABLE_GSDEV_TOOLS=true
ENABLE_THREE_STATS=true
ENABLE_PROFILER=true

# Memory & Session Management
AGENT_MEMORY_ENABLED=true
SESSION_CACHE_ENABLED=true
DEEP_ANALYSIS_ENABLED=true

# Design System Paths
DESIGN_TOKENS_PATH=./src/styles/tokens
SHADERS_PATH=./src/shaders
MODELS_PATH=./public/models
TEXTURES_PATH=./public/textures

# Atmospheric Effects
CSS_BACKDROP_FILTER_ENABLED=true
MOTION_BLUR_ENABLED=true
DEPTH_OF_FIELD_ENABLED=false

# Analytics & Monitoring
PERFORMANCE_MONITORING=true
ERROR_TRACKING=true
INTERACTION_LOGGING=false

# Build Configuration
BUILD_MINIFY=terser
BUILD_TARGET=esnext
BUILD_CHUNK_SIZE=500
